    [file join $RTL_LIB neg_ones10b design.v] \
    [file join $RTL_LIB neg_twos11b design.v] \
    [file join $RTL_LIB neg_ones11b design.v] \
    [file join $RTL_LIB neg_twos12b design.v] \
    [file join $RTL_LIB neg_ones12b design.v] \
    [file join $RTL_LIB neg_twos13b design.v] \
    [file join $RTL_LIB neg_ones13b design.v] \
    [file join $RTL_LIB neg_twos14b design.v] \
    [file join $RTL_LIB neg_ones14b design.v] \
