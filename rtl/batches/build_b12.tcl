    [file join $RTL_LIB neg_ones15b design.v] \
    [file join $RTL_LIB neg_twos16b design.v] \
    [file join $RTL_LIB neg_ones16b design.v] \
    [file join $RTL_LIB abs3b design.v] \
    [file join $RTL_LIB abs4b design.v] \
    [file join $RTL_LIB abs5b design.v] \
    [file join $RTL_LIB abs6b design.v] \
