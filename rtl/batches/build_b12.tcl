# Auto-generated by gen_bitstream.py  -  batch 12 (self-contained).
# Build:  vivado -mode batch -source build_b12.tcl
set BATCH   12
set PART    "xc7z020clg400-1"     ;# PYNQ-Z2 (Zynq-7020)
set CLK_MHZ 100
# Repo root = two levels up from this script (rtl/batches/ -> repo root).
set ROOT    [file normalize [file join [file dirname [info script]] .. ..]]
set RTL_LIB [file join $ROOT rtl_library]
set OUT     [file join $ROOT rtl batches out_b12]
file mkdir $OUT

create_project sys_b12 [file join $OUT proj] -part $PART -force
add_files [list \
    [file join $ROOT rtl la_axi_wide.v] \
    [file join $ROOT rtl batches dut_top_b12.v] \
    [file join $RTL_LIB gray15 design.v] \
    [file join $RTL_LIB parity16 design.v] \
    [file join $RTL_LIB popcount16 design.v] \
    [file join $RTL_LIB reverse16 design.v] \
    [file join $RTL_LIB gray16 design.v] \
    [file join $RTL_LIB neg_twos3b design.v] \
    [file join $RTL_LIB neg_ones3b design.v] \
    [file join $RTL_LIB neg_twos4b design.v] \
    [file join $RTL_LIB neg_ones4b design.v] \
    [file join $RTL_LIB neg_twos5b design.v] \
    [file join $RTL_LIB neg_ones5b design.v] \
    [file join $RTL_LIB neg_twos6b design.v] \
