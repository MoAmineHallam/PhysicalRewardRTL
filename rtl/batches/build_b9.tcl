# Auto-generated by gen_bitstream.py  -  batch 9 (self-contained).
# Build:  vivado -mode batch -source build_b9.tcl
set BATCH   9
set PART    "xc7z020clg400-1"     ;# PYNQ-Z2 (Zynq-7020)
set CLK_MHZ 100
# Repo root = two levels up from this script (rtl/batches/ -> repo root).
