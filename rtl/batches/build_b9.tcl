set RTL_LIB [file join $ROOT rtl_library]
set OUT     [file join $ROOT rtl batches out_b9]
file mkdir $OUT

create_project sys_b9 [file join $OUT proj] -part $PART -force
add_files [list \
    [file join $ROOT rtl la_axi_wide.v] \
    [file join $ROOT rtl batches dut_top_b9.v] \
    [file join $RTL_LIB rotate_lsh16 design.v] \
