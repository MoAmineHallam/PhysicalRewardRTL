  "text": "// 20-tap direct-form FIR, 8-bit samples, PIPELINED: products registered in\n// stage 1, summed in stage 2 -> shorter register-to-register path, higher Fmax.\n// Functionally identical to the reference up to a fixed extra latency.\nmodule firr20_v6 (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg [23:0] a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19;\n    wire [23:0] p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16, p17, p18, p19;\n    reg [23:0] s;\n    always @(*) begin\n        p0 = 4 * x + 'd0; a0 = p0;\n        p1 = 8 * x + a0; a1 = p1;\n        p2 = 12 * x + a1; a2 = p2;\n        p3 = 16 * x + a2; a3 = p3;\n        p4 = 20 * x + a3; a4 = p4;\n        p5 = 24 * x + a4; a5 = p5;\n        p6 = 28 * x + a5; a6 = p6;\n        p7 = 32 * x + a6; a7 = p7;\n        p8 = 36 * x + a7; a8 = p8;\n        p9 = 40 * x + a8; a9 = p9;\n        p10 = 44 * x + a9; a10 = p10;\n        p11 = 48 * x + a10; a11 = p11;\n        p12 = 52 * x + a11; a12 = p12;\n        p13 = 56 * x + a12; a13 = p13;\n        p14 = 60 * x + a13; a14 = p14;\n        p15 = 64 * x + a14; a15 = p15;\n        p16 = 68 * x + a15; a16 = p16;\n        p17 = 72 * x + a16; a17 = p17;\n        p18 = 76 * x + a17; a18 = p18;\n        p19 = 80 * x + a18; a19 = p19;\n        s = p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p12 + p13 + p14 + p15 + p16 + p17 + p18 + p19;\n    end\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            y <= 16'd0;\n            a0 <= 24'd0; a1 <= 24'd0; a2 <= 24'd0; a3 <= 24'd0; a4 <= 24'd0; a5 <= 24'd0; a6 <= 24'd0; a7 <= 24'd0; a8 <= 24'd0; a9 <= 24'd0; a10 <= 24'd0; a11 <= 24'd0; a12 <= 24'd0; a13 <= 24'd0; a14 <= 24'd0; a15 <= 24'd0; a16 <= 24'd0; a17 <= 24'd0; a18 <= 24'd0; a19 <= 24'd0;\n        end else begin\n            y <= s[15:0];\n        end\n    end\nendmodule"
}
