  "text": "// 18-tap direct-form FIR, 8-bit samples, PIPELINED: products registered in\n// stage 1, summed in stage 2 -> shorter register-to-register path, higher Fmax.\n// Functionally identical to the reference up to a fixed extra latency.\nmodule firr18_v5 (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg  [7:0]  xs [0:17];\n    reg  [15:0] p  [0:17];\n    integer     i;\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            for (i = 0; i < 18; i = i + 1) begin xs[i] <= 8'd0; p[i] <= 16'd0; end\n            y <= 16'd0;\n        end else begin\n            xs[0] <= x;\n            for (i = 1; i < 18; i = i + 1) xs[i] <= xs[i-1];\n            p[0] <= 8'd2 + 3 * x;\n            p[1] <= 16'd2 * xs[0] + 8'd2 + 3 * xs[1];\n            p[2] <= 16'd4 * xs[1] + 16'd2 * xs[0] + 8'd2 + 3 * xs[2];\n            p[3] <= 16'd6 * xs[2] + 16'd4 * xs[1] + 16'd2 * xs[0] + 8'd2 + 3 * xs[3];\n            p[4] <= 16'd8 * xs[3] + 16'd6 * xs[2] + 16'd4 * xs[1] + 16'd2 * xs[0] + 8'd2 + 3 * xs[4];\n            p[5] <= 16'd10 * xs[4] + 16'd8 * xs[3] + 16'd6 * xs[2] + 16'd4 * xs[1] + 16'd2 * xs[0] + 8'd2 + 3 * xs[5];\n            p[6] <= 16'd12 * xs[5] + 16'd10 * xs[4] + 16'd8 * xs[3] + 16'd6 * xs[2] + 16'd4 * xs[1] + 16'd2 * xs[0] + 8'd2 + 3 * xs[6];\n            p[7] <= 16'd14 * xs[6] + 16'd12 * xs[5] + 16'd10 * xs[4] + 16'd8 * xs[3] + 16'd6 * xs[2] + 16'd4 * xs[1] + 16'd2 * xs[0] + 8'd2 + 3 * xs[7];\n            p[8] <= 16'd16 * xs[7] + 16'd14 * xs[6] + 16'd12 * xs[5] + 16'd10 * xs[4] + 16'd8 * xs[3] + 16'd6 * xs[2] + 16'd4 * xs[1] + 16'd2 * xs[0] + 8'd2 + 3 * xs[8];\n            p[9] <= 16'd18 * xs[8] + 16'd16 * xs[7] + 16'd14 * xs[6] + 16'd12 * xs[5] + 16'd10 * xs[4] + 16'd8 * xs[3] + 16'd6 * xs[2] + 16'd4 * xs[1] + 16'd2 * xs[0] + 8'd2 + 3 * xs[9];\n            p[10] <= 16'd20 * xs[9] + 16'd18 * xs[8] + 16'd16 * xs[7] + 16'd14 * xs[6] + 16'd12 * xs[5] + 16'd10 * xs[4] + 16'd8 * xs[3] + 16'd