  "text": "// 27-tap direct-form FIR, 8-bit samples, unpipelined MAC cone (the long\n// register-to-register path -> lower Fmax; pipeline it to go faster).\nmodule firr27_v3 (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg [23:0] a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26;\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            a0 <= 24'd0; a1 <= 24'd0; a2 <= 24'd0; a3 <= 24'd0; a4 <= 24'd0; a5 <= 24'd0; a6 <= 24'd0; a7 <= 24'd0; a8 <= 24'd0; a9 <= 24'd0; a10 <= 24'd0; a11 <= 24'd0; a12 <= 24'd0; a13 <= 24'd0; a14 <= 24'd0; a15 <= 24'd0; a16 <= 24'd0; a17 <= 24'd0; a18 <= 24'd0; a19 <= 24'd0; a20 <= 24'd0; a21 <= 24'd0; a22 <= 24'd0; a23 <= 24'd0; a24 <= 24'd0; a25 <= 24'd0; a26 <= 24'd0; y <= 16'd0;\n        end else begin\n            a0 <= 24'd2 * 8'd38 + 5'd32;\n            a1 <= 24'd2 * 8'd41 + 5'd35;\n            a2 <= 24'd2 * 8'd37 + 5'd37;\n            a3 <= 24'd2 * 8'd39 + 5'd38;\n            a4 <= 24'd2 * 8'd33 + 5'd40;\n            a5 <= 24'd2 * 8'd35 + 5'd39;\n            a6 <= 24'd2 * 8'd34 + 5'd39;\n            a7 <= 24'd2 * 8'd36 + 5'd38;\n            a8 <= 24'd2 * 8'd32 + 5'd40;\n            a9 <= 24'd2 * 8'd35 + 5'd39;\n            a10 <= 24'd2 * 8'd38 + 5'd37;\n            a11 <= 24'd2 * 8'd38 + 5'd38;\n            a12 <= 24'd2 * 8'd39 + 5'd39;\n            a13 <= 24'd2 * 8'd41 + 5'd37;\n            a14 <= 24'd2 * 8'd34 + 5'd40;\n            a15 <= 24'd2 * 8'd39 + 5'd38;\n            a16 <= 24'd2 * 8'd38 + 5'd37;\n            a17 <= 24'd2 * 8'd36 + 5'd39;\n            a18 <= 24'd2 * 8'd33 + 5'd39;\n            a19 <= 24'd2 * 8'd35 + 5'd38;\n            a20 <= 24'd2 * 8'd38 + 5'd37;\n            a21 <= 24'd2 * 8'd38 + 5'd38;\n            a22 <= 24'd2 * 8'd39 + 5'd39;\n            a23 <= 24'd2 * 8'd41 + 5'd37;\n            a24 <= 24'd2 * 8'd33 + 5'd40;\n            a25 <= 24'd2 * 8'd39 + 5'd38;\n            a26 <= 24'd2 * 8'd38 + 5'd37;\n            y <= a0[15:0];\n        end\n    end\nend//-------------------------------------------------------------------------\n//    Color_Mapper.sv                                                           \n//    Zuhao Jin and David Chiu\n//    Fall 2021                                                               \n//                                                                             \n//    An Arduino-based LED pixel project                                                      \n//                                                                             \n//                                                                             \n//-------------------------------------------------------------------------\n\nmodule  color_mapper ( input        [9:0] DrawX, DrawY,\n\t\t\t\t\t\t\t  input        [8:0] RGB_Data,\n\t\t\t\t\t\t\t  output logic [7:0] Red, Green, Blue\n\t\t\t\t\t\t\t  );\n    \n    // Output colors to RGB LED.\n    // The colors change at the edges of the screen for a smooth blink effect.\n    // The specific colors used can be changed to any desired colors.\n    always_comb\n    begin\n        if ((DrawX <= 4 && DrawY <= 4) || (DrawX >= 844 && DrawY <= 4) || (DrawX <= 4 && DrawY >= 544) || (DrawX >= 844 && DrawY >= 544))\n        begin\n            Red = 8'h00;\n            Green = 8'h44;\n            Blue = 8'hFF;\n        end\n        else if ((DrawX <= 8 && DrawY <= 8) || (DrawX >= 840 && DrawY <= 8) || (DrawX <= 8 && DrawY >= 540) || (DrawX >= 840 && DrawY >= 540))\n        begin\n            Red = 8'h00;\n           "
