  "text": "// 27-tap FIR, TRANSPOSED direct form: one multiply + one add per stage, so the\n// register-to-register critical path is independent of tap count -> high Fmax.\n// Same transfer function as the direct form (equivalent up to a fixed latency).\nmodule firr27_v3 (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg  [23:0] a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26;\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            a0 <= 24'd0; a1 <= 24'd0; a2 <= 24'd0; a3 <= 24'd0; a4 <= 24'd0; a5 <= 24'd0; a6 <= 24'd0; a7 <= 24'd0; a8 <= 24'd0; a9 <= 24'd0; a10 <= 24'd0; a11 <= 24'd0; a12 <= 24'd0; a13 <= 24'd0; a14 <= 24'd0; a15 <= 24'd0; a16 <= 24'd0; a17 <= 24'd0; a18 <= 24'd0; a19 <= 24'd0; a20 <= 24'd0; a21 <= 24'd0; a22 <= 24'd0; a23 <= 24'd0; a24 <= 24'd0; a25 <= 24'd0; a26 <= 24'd0; y <= 16'd0;\n        end else begin\n            a0 <= 8'd2 * x + 5 => $short_mult_add((2*1 + 5), x);\n            a1 <= 8'd4 * a0[7:0] + 5 => $short_mult_add((2*2 + 5), a0[7:0]);\n            a2 <= 8'd6 * a1[7:0] + 5 => $short_mult_add((2*3 + 5), a1[7:0]);\n            a3 <= 8'd8 * a2[7:0] + 5 => $short_mult_add((2*4 + 5), a2[7:0]);\n            a4 <= 8'd10 * a3[7:0] + 5 => $short_mult_add((2*5 + 5), a3[7:0]);\n            a5 <= 8'd12 * a4[7:0] + 5 => $short_mult_add((2*6 + 5), a4[7:0]);\n            a6 <= 8'd14 * a5[7:0] + 5 => $short_mult_add((2*7 + 5), a5[7:0]);\n            a7 <= 8'd16 * a6[7:0] + 5 => $short_mult_add((2*8 + 5), a6[7:0]);\n            a8 <= 8'd18 * a7[7:0] + 5 => $short_mult_add((2*9 + 5), a7[7:0]);\n            a9 <= 8'd20 * a8[7:0] + 5 => $short_mult_add((2*10 + 5), a8[7:0]);\n            a10 <= 8'd22 * a9[7:0] + 5 => $short_mult_add((2*11 + 5), a9[7:0]);\n            a11 <= 8'd24 * a10[7:0] + 5 => $short_mult_add((2*12 + 5), a10[7:0]);\n            a12 <= 8'd26 * a11[7:0] + 5 => $short_mult_add((2*13 + 5), a11[7:0]);\n            a13 <= 8'd28 * a12[7:0] + 5 => $short_mult_add((2*14 + 5), a12[7:0]);\n            a14 <= 8'd30 * a13[7:0] + 5 => $short_mult_add((2*15 + 5), a13[7:0]);\n            a15 <= 8'd32 * a14[7:0] + 5 => $short_mult_add((2*16 + 5), a14[7:0]);\n            a16 <= 8'd34 * a15[7:0] + 5 => $short_mult_add((2*17 + 5), a15[7:0]);\n            a17 <= 8'd36 * a16[7:0] + 5 => $short_mult_add((2*18 + 5), a16[7:0]);\n            a18 <= 8'd38 * a17[7:0] + 5 => $short_mult_add((2*19 + 5), a17[7:0]);\n            a19 <= 8'd40 * a18[7:0] + 5 => $short_mult_add((2*20 + 5), a18[7:0]);\n            a20 <= 8'd42 * a19[7:0] + 5 => $short_mult_add((2*21 + 5), a19[7:0]);\n            a21 <= 8'd44 * a20[7:0] + 5 => $short_mult_add((2*22 + 5), a20[7:0]);\n            a22 <= 8'd46 * a21[7:0] + 5 => $short_mult_add((2*23 + 5), a21[7:0]);\n            a23 <= 8'd48 * a22[7:0] + 5 => $short_mult_add((2*24 + 5), a22[7:0]);\n            a24 <= 8"
