  "text": "// 42-tap FIR, TRANSPOSED direct form: one multiply + one add per stage, so the\n// register-to-register critical path is independent of tap count -> high Fmax.\n// Same transfer function as the direct form (equivalent up to a fixed latency).\nmodule firr42_v3 (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg [23:0] a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, a32, a33, a34, a35, a36, a37, a38, a39, a40, a41;\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            a0 <= 24'd0; a1 <= 24'd0; a2 <= 24'd0; a3 <= 24'd0; a4 <= 24'd0; a5 <= 24'd0; a6 <= 24'd0; a7 <= 24'd0; a8 <= 24'd0; a9 <= 24'd0; a10 <= 24'd0; a11 <= 24'd0; a12 <= 24'd0; a13 <= 24'd0; a14 <= 24'd0; a15 <= 24'd0; a16 <= 24'd0; a17 <= 24'd0; a18 <= 24'd0; a19 <= 24'd0; a20 <= 24'd0; a21 <= 24'd0; a22 <= 24'd0; a23 <= 24'd0; a24 <= 24'd0; a25 <= 24'd0; a26 <= 24'd0; a27 <= 24'd0; a28 <= 24'd0; a29 <= 24'd0; a30 <= 24'd0; a31 <= 24'd0; a32 <= 24'd0; a33 <= 24'd0; a34 <= 24'd0; a35 <= 24'd0; a36 <= 24'd0; a37 <= 24'd0; a38 <= 24'd0; a39 <= 24'd0; a40 <= 24'd0; a41 <= 24'd0; y <= 16'd0;\n        end else begin\n            a0 <= 8'd2 * x + 5'd32;\n            a1 <= a0 * 8'd2 + 5'd40;\n            a2 <= a1 * 8'd2 + 5'd48;\n            a3 <= a2 * 8'd2 + 5'd56;\n            a4 <= a3 * 8'd2 + 5'd64;\n            a5 <= a4 * 8'd2 + 5'd72;\n            a6 <= a5 * 8'd2 + 5'd80;\n            a7 <= a6 * 8'd2 + 5'd88;\n            a8 <= a7 * 8'd2 + 5'd96;\n            a9 <= a8 * 8'd2 + 5'd104;\n            a10 <= a9 * 8'd2 + 5'd112;\n            a11 <= a10 * 8'd2 + 5'd120;\n            a12 <= a11 * 8'd2 + 5'd128;\n            a13 <= a12 * 8'd2 + 5'd136;\n            a14 <= a13 * 8'd2 + 5'd144;\n            a15 <= a14 * 8'd2 + 5'd152;\n            a16 <= a15 * 8'd2 + 5'd160;\n            a17 <= a16 * 8'd2 + 5'd168;