  "text": "// 27-tap FIR, TRANSPOSED direct form: one multiply + one add per stage, so the\n// register-to-register critical path is independent of tap count -> high Fmax.\n// Same transfer function as the direct form (equivalent up to a fixed latency).\nmodule firr27_v3 (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg [23:0] a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26;\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            a0 <= 24'd0; a1 <= 24'd0; a2 <= 24'd0; a3 <= 24'd0; a4 <= 24'd0; a5 <= 24'd0; a6 <= 24'd0; a7 <= 24'd0; a8 <= 24'd0; a9 <= 24'd0; a10 <= 24'd0; a11 <= 24'd0; a12 <= 24'd0; a13 <= 24'd0; a14 <= 24'd0; a15 <= 24'd0; a16 <= 24'd0; a17 <= 24'd0; a18 <= 24'd0; a19 <= 24'd0; a20 <= 24'd0; a21 <= 24'd0; a22 <= 24'd0; a23 <= 24'd0; a24 <= 24'd0; a25 <= 24'd0; a26 <= 24'd0; y <= 16'd0;\n        end else begin\n            a0 <= 8'd2 * x + 5'd17;\n            a1 <= 8'd4 * x + 5'd16;\n            a2 <= 8'd6 * x + 5'd15;\n            a3 <= 8'd8 * x + 5'd14;\n            a4 <= 8'd10 * x + 5'd13;\n            a5 <= 8'd12 * x + 5'd12;\n            a6 <= 8'd14 * x + 5'd11;\n            a7 <= 8'd16 * x + 5'd10;\n            a8 <= 8'd18 * x + 5'd9;\n            a9 <= 8'd20 * x + 5'd8;\n            a10 <= 8'd22 * x + 5'd7;\n            a11 <= 8'd24 * x + 5'd6;\n            a12 <= 8'd26 * x + 5'd5;\n            a13 <= 8'd28 * x + 5'd4;\n            a14 <= 8'd30 * x + 5'd3;\n            a15 <= 8'd32 * x + 5'd2;\n            a16 <= 8'd34 * x + 5'd1;\n            a17 <= 8'd36 * x + 5'd0;\n            a18 <= 8'd38 * x;\n            a19 <= 8'd40 * x;\n            a20 <= 8'd42 * x;\n            a21 <= 8'd44 * x;\n            a22 <= 8'd46 * x;\n            a23 <= 8'd48 * x;\n            a24 <= 8'd50 * x;\n            a25 <= 8'd52 * x;\n            a26 <= 8'd54 * x;\n            y <= a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23 + a24 + a25 + a26;\n        End\n//==============================================================================================\n// File Name       : gpio_top.sv\n// Project Name    : GPIO_2x16\n// Author          : Kirillov Anton\n// Create Date     : 06.07.2022\n// Revision        : 0.1\n//==============================================================================================\n// Module: gpio_top\n// The top level module that instantiates the other necessary modules and connects them together.\n//==============================================================================================\nmodule gpio_top (\n    input               clk,\n    input               rst_n,\n    //IOPads\n    inout [15:0]        io_pads,\n    input [7:0]         intr_reg,\n    output reg          gpio_intr,\n    input               test_mode_in,\n    // AXI4-Lite interface\n    input               s_axi_awvalid,\n    input   [31:0]      s_axi_awaddr,\n    input               s_axi_wvalid,\n    input   [31:0]      s_axi_wdata,\n    output  reg         s_axi_bvalid,\n    output  reg [1:0]   s_axi_bresp,\n    input               s_axi_bready,\n    input               s_axi_arvalid,\n    input   [31:0]      s_axi_araddr,\n    output  reg         s_axi_rvalid,\n    output  reg [31:0]  s_axi_rdata,\n    output  reg [1:0]   s_axi_rresp,\n    input               s_axi_rready\n);\n\n    reg [15:0]      gpio_outreg;\n    wire    [15:0]  gpio_inreg;"
}
