  "text": "// 34-tap FIR, TRANSPOSED direct form: one multiply + one add per stage, so the\n// register-to-register stage latency is independent of the tap count -> faster,\n// higher Fmax. Same transfer function as the direct form (equivalent up to a\n// fixed latency).\nmodule fir34_v1_8b (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg [23:0] a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, a32, a33;\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            a0 <= 24'd0; a1 <= 24'd0; a2 <= 24'd0; a3 <= 24'd0; a4 <= 24'd0; a5 <= 24'd0; a6 <= 24'd0; a7 <= 24'd0; a8 <= 24'd0; a9 <= 24'd0; a10 <= 24'd0; a11 <= 24'd0; a12 <= 24'd0; a13 <= 24'd0; a14 <= 24'd0; a15 <= 24'd0; a16 <= 24'd0; a17 <= 24'd0; a18 <= 24'd0; a19 <= 24'd0; a20 <= 24'd0; a21 <= 24'd0; a22 <= 24'd0; a23 <= 24'd0; a24 <= 24'd0; a25 <= 24'd0; a26 <= 24'd0; a27 <= 24'd0; a28 <= 24'd0; a29 <= 24'd0; a30 <= 24'd0; a31 <= 24'd0; a32 <= 24'd0; a33 <= 24'd0; y <= 16'd0;\n        end else begin\n            a0 <= 8'd59 * x + a1;\n            a1 <= 8'd41 * x + a2;\n            a2 <= 8'd24 * x + a3;\n            a3 <= 8'd13 * x + a4;\n            a4 <= 8'd56 * x + a5;\n            a5 <= 8'd5 * x + a6;\n            a6 <= 8'd31 * x + a7;\n            a7 <= 8'd61 * x + a8;\n            a8 <= 8'd44 * x + a9;\n            a9 <= 8'd42 * x + a10;\n            a10 <= 8'd13 * x + a11;\n            a11 <= 8'd1 * x + a12;\n            a12 <= 8'd7 * x + a13;\n            a13 <= 8'd58 * x + a14;\n            a14 <= 8'd21 * x + a15;\n            a15 <= 8'd7 * x + a16;\n            a16 <= 8'd19 * x + a17;\n            a17 <= 8'd28 * x + a18;\n            a18 <= 8'd23 * x + a19;\n            a19 <= 8'd26 * x + a20;\n            a20 <= 8'd39 * x + a21;\n            a21 <= 8'd33 * x + a22;\n            a22 <= 8'd5 * x + a23;\n            a23 <= 8'd57 * x + a24;\n            a24 <= 8'd28 * x + a25;\n            a25 <= 8'd11 * x + a26;\n            a26 <= 8'd18 * x + a27;\n            a27 <= 8'd34 * x + a28;\n            a28 <= 8'd5 * x + a29;\n            a29 <= 8'd11 * x + a30;\n            a30 <= 8'd53 * x + a31;\n            a31 <= 8'd14 * x + a32;\n            a32 <= 8'd1 * x + a33;\n            a33 <= 8'd48 * x;\n            y <= a0[15:0];\n        end\n    end\nend//============================================================================\n//  Arcade: Lars the Lander\n//\n//  Port to MiSTer\n//  Copyright (C) 2020-2021 Sorgelig\n//\n//  This program is free software; you can redistribute it and/or modify it\n//  under the terms of the GNU General Public License as published by the Free\n//  Software Foundation; either version 2 of the License, or (at your option)\n//  any later version.\n//\n//  This program is distributed in the hope that it will be useful, but WITHOUT\n//  ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or\n//  FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for\n//  more details.\n//\n//  You should have received a copy of the GNU General Public License along\n//  with this program; if not, write to the Free Software Foundation, Inc.,\n//  51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.\n//============================================================================\n \nmodule emu\n(\n\t//Master input clock\n\tinput         CLK_50M,\n\n\t//Async reset from top-level module.\n\t//Can be used asynchronously"
}
