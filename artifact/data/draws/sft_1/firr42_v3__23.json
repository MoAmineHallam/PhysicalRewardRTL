d0; r5 <= 8'd0; r6 <= 8'd0; r7 <= 8'd0; r8 <= 8'd0; r9 <= 8'd0; r10 <= 8'd0; r11 <= 8'd0; r12 <= 8'd0; r13 <= 8'd0; r14 <= 8'd0; r15 <= 8'd0; r16 <= 8'd0; r17 <= 8'd0; r18 <= 8'd0; r19 <= 8'd0; r20 <= 8'd0; r21 <= 8'd0; r22 <= 8'd0; r23 <= 8'd0; r24 <= 8'd0; r25 <= 8'd0; r26 <= 8'd0; r27 <= 8'd0; r28 <= 8'd0; r29 <= 8'd0; r30 <= 8'd0; r31 <= 8'd0; r32 <= 8'd0; r33 <= 8'd0; r34 <= 8'd0; r35 <= 8'd0; r36 <= 8'd0; r37 <= 8'd0; r38 <= 8'd0; r39 <= 8'd0; r40 <= 8'd0; r41 <= 8'd0;\n        end else begin"
