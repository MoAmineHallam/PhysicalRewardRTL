  "text": "// 20-tap direct-form FIR, 8-bit samples, PIPELINED: products registered in\n// stage 1, summed in stage 2 -> shorter register-to-register path, higher Fmax.\n// Functionally identical to the reference up to a fixed extra latency.\nmodule firr20_v6 (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg  [7:0]  xs [0:19];\n    reg  [15:0] p  [0:19];\n    integer     i;\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            for (i = 0; i < 20; i = i + 1) begin xs[i] <= 8'd0; p[i] <= 16'd0; end\n            y <= 16'd0;\n        end else begin\n            xs[0] <= x;\n            for (i = 1; i < 20; i = i + 1) xs[i] <= xs[i-1];\n            p[0] <= 8'd4 * xs[0] + 8'd0;\n            p[1] <= 8'd4 * xs[1] + 8'd4 * xs[0] + 8'd0;\n            p[2] <= 8'd4 * xs[2] + 8'd8 * xs[0] + 8'd4 * xs[1] + 8'd0;\n            p[3] <= 8'd4 * xs[3] + 8'd12 * xs[0] + 8'd8 * xs[1] + 8'd4 * xs[2] + 8'd0;\n            p[4] <= 8'd4 * xs[4] + 8'd16 * xs[0] + 8'd12 * xs[1] + 8'd8 * xs[2] + 8'd4 * xs[3] + 8'd0;\n            p[5] <= 8'd4 * xs[5] + 8'd20 * xs[0] + 8'd16 * xs[1] + 8'd12 * xs[2] + 8'd8 * xs[3] + 8'd8'd4 * xs[4] + 8'd0;\n            p[6] <= 8'd4 * xs[6] + 8'd24 * xs[0] + 8'd20 * xs[1] + 8'd16 * xs[2] + 8'd12 * xs[3] + 8'd8 * xs[4] + 8'd4 * xs[5] + 8'd0;\n            p[7] <= 8'd4 * xs[7] + 8'd28 * xs[0] + 8'd24 * xs[1] + 8'd20 * xs[2] + 8'd16 * xs[3] + 8'd12 * xs[4] + 8'd8 * xs[5] + 8'd4 * xs[6] + 8'd0;\n            p[8] <= 8'd4 * xs[8] + 8'd32 * xs[0] + 8'd28 * xs[1] + 8'd24 * xs[2] + 8'd20 * xs[3] + 8'd16 * xs[4] + 8'd12 * xs[5] + 8'd8 * xs[6] + 8'd4 * xs[7] + 8'd0;\n            p[9] <= 8'd4 * xs[9] + 8'd36 * xs[0] + 8'd32 * xs[1] + 8'd28 * xs[2] + 8'd24 * xs[3] + 8'd20 * xs[4] + 8'd16 * xs[5] + 8'd12 * xs[6] + 8'd8 * xs[7] + 8'd4 * xs[8] + 8'd0;\n            p[10] <= 8'd4 * xs[10] + 8'd40 * xs[0] + 8'd36 * xs[1] + 8'd32 * xs[2] + 8'd28 * xs[3] + 8'd24 * xs[4] + 8'd20 * xs[5] + 8'd16