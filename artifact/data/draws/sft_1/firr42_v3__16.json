  "text": "// 42-tap FIR, TRANSPOSED form (the \"direct form\"): register-to-register function\n// combinational sum-of-products (no arrays, no slices) + ONE register per stage\n// (per-stage register -> shorter register-to-register path; the long path\n// traversed explicitly by the combinational sum-of-products goes roughly\n// linearly with the number of stages). Same transfer function as the direct\n// form (the register-to-register path is the same, just reordered).\nmodule firr42_v3 (\n    input  wire        clk,\n    input  wire        rst_n,\n    input  wire [7:0]  x,\n    output reg  [15:0] y\n);\n    reg [23:0] a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, a32, a33, a34, a35, a36, a37, a38, a39, a40, a41;\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            a0 <= 24'd0; a1 <= 24'd0; a2 <= 24'd0; a3 <= 24'd0; a4 <= 24'd0; a5 <= 24'd0; a6 <= 24'd0; a7 <= 24'd0; a8 <= 24'd0; a9 <= 24'd0; a10 <= 24'd0; a11 <= 24'd0; a12 <= 24'd0; a13 <= 24'd0; a14 <= 24'd0; a15 <= 24'd0; a16 <= 24'd0; a17 <= 24'd0; a18 <= 24'd0; a19 <= 24'd0; a20 <= 24'd0; a21 <= 24'd0; a22 <= 24'd0; a23 <= 24'd0; a24 <= 24'd0; a25 <= 24'd0; a26 <= 24'd0; a27 <= 24'd0; a28 <= 24'd0; a29 <= 24'd0; a30 <= 24'd0; a31 <= 24'd0; a32 <= 24'd0; a33 <= 24'd0; a34 <= 24'd0; a35 <= 24'd0; a36 <= 24'd0; a37 <= 24'd0; a38 <= 24'd0; a39 <= 24'd0; a40 <= 24'd0; a41 <= 24'd0; y <= 16'd0;\n        end else begin\n            a0 <= 24'd2 * 8'd35 + 24'd5;\n            a1 <= 24'd2 * 8'd59 + 24'd5;\n            a2 <= 24'd2 * 8'd93 + 24'd5;\n            a3 <= 24'd2 * 8'd127 + 24'd5;\n            a4 <= 24'd2 * 8'd161 + 24'd5;\n            a5 <= 24'd2 * 8'd195 + 24'd5;\n            a6 <= 24'd2 * 8'd229 + 24'd5;\n            a7 <= 24'd2 * 8'd263 + 24'd5;\n            a8 <= 24'd2 * 8'd297 + 24'd5;\n            a9 <= 24'd2 * 8'd331 + 24'd5;\n            a10 <= 24'd2 * 8'd365 + 24'd5;\n            a11 <= 24'd2 * 8'd399 + 24'd5;\n            a12 <= 24'd2 * 8'd433 + 24'd5;\n            a13 <= 24'd2 * 8'd467 + 24'd5;\n            a14 <= 24'd2 * 8'd501 + 24'd5;\n            a15 <= 24'd2 * 8'd535 + 24'd5;\n            a16 <= 24'd2 * 8'd569 + 24'd5;\n            a17 <= 24'd2 * 8'd603 + 24'd5;\n            a18 <= 24'd2 * 8'd637 + 24'd5;\n            a19 <= 24'd2 * 8'd671 + 24'd5;\n            a20 <= 24'd2 * 8'd705 + 24'd5;\n            a21 <= 24'd2 * 8'd739 + 24'd5;\n            a22 <= 24'd2 * 8'd773 + 24'd5;\n            a23 <= 24'd2 * 8'd807 + 24'd5;\n            a24 <= 24'd2 * 8'd841 + 24'd5;\n            a25 <= 24'd2 * 8'd875 + 24'd5;\n            a26 <= 24'd2 * 8'd909 + 24'd5;\n            a27 <= 24'd2 * 8'd943 + 24'd5;\n            a28 <= 24'd2 * 8'd977 + 24'd5;\n           "
