{"design": "mod158_counter", "family": "mod_counter", "reward": 0.6152930402930403, "compile_ok": true, "rtl": "module mod158_counter (\n    input  wire clk,\n    input  wire rst_n,\n    output reg  [7:0] count\n);\n\nreg [7:0] counter;\nreg [2:0] state;\n\nalways @(posedge clk or negedge rst_n) begin\n    if (~rst_n) begin\n        counter <= 0;\n        state <= 0;\n    end else begin\n        case(state)\n            0: begin\n                counter <= 0;\n                state <= 1;\n            end\n            1: begin\n                counter <= counter + 1;\n                if (counter == 157) begin\n                    state <= 2;\n                end\n            end\n            2: begin\n                counter <= 0;\n                state <= 1;\n            end\n        endcase\n    end\nend\n\nassign count = counter;\n\nendmodule"}
{"design": "mod158_counter", "family": "mod_counter", "reward": 0.0, "compile_ok": false, "rtl": "module mod158_counter (\n    input  wire clk,\n    input  wire rst_n,\n    output reg  [7:0] count\n);\n\n    // Define a constant for the modulo-158 value\n    localparam MOD158 = 158;\n\n    // Define a counter module that counts from 0 to MOD158\n    counter #(\n        .MOD(MOD158)\n    ) i_counter (\n        .clk(clk),\n        .rst_n(rst_n),\n        .count(c_count),\n        .overflow(c_overflow)\n    );\n\n    // Define a wire to capture the overflow signal from the counter module\n    wire c_overflow;\n    \n    // Define a wire to capture the count value from the counter module\n    reg [7:0] c_count;\n    \n    // Define a register to store the previous count value\n    reg [7:0] prev_count;\n\n    // When the reset signal is active, clear the outputs and reset the counter\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            count <= 8'b0;\n            prev_count <= 8'b0;\n        end else begin\n            // If the counter overflows, add 1 to the previous count value\n            if (c_overflow) begin\n                prev_count <= prev_count + 1;\n            end\n            // If the counter does not overflow, use the current count value\n            else begin\n                prev_count <= c_count;\n            end\n            // Update the output value based on the previous count value\n            count <= prev_count;\n        end\n    end\n\nendmodule"}
